fdt addr ${fdt_addr} && fdt get value bootargs /chosen bootargs

test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B"
test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3
test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3

setenv bootpart
setenv rootpart
setenv raucslot

for BOOT_SLOT in "${BOOT_ORDER}"; do
    if test -n "${bootpart}"; then
        # A slot has already been selected.
    elif test "x${BOOT_SLOT}" = "xA"; then
        if itest ${BOOT_A_LEFT} -gt 0; then
            setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1
            echo "RAUC: booting slot A (${BOOT_A_LEFT} tries left)"
            setenv bootpart "mmc 0:2"
            setenv rootpart "root=PARTLABEL=rootfs-a"
            setenv raucslot "A"
        fi
    elif test "x${BOOT_SLOT}" = "xB"; then
        if itest ${BOOT_B_LEFT} -gt 0; then
            setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1
            echo "RAUC: booting slot B (${BOOT_B_LEFT} tries left)"
            setenv bootpart "mmc 0:3"
            setenv rootpart "root=PARTLABEL=rootfs-b"
            setenv raucslot "B"
        fi
    fi
done

if test -z "${bootpart}"; then
    echo "RAUC: no bootable slot; restoring both retry counters"
    setenv BOOT_A_LEFT 3
    setenv BOOT_B_LEFT 3
    saveenv
    reset
fi

setenv bootargs "${bootargs} ${rootpart} rootwait rw rauc.slot=${raucslot}"
saveenv

load ${bootpart} ${kernel_addr_r} boot/@@KERNEL_IMAGETYPE@@
@@KERNEL_BOOTCMD@@ ${kernel_addr_r} - ${fdt_addr}

# If loading or booting returned, consume another attempt on the next reset.
reset
