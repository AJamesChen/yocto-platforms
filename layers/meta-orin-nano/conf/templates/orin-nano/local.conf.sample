# Build for the NVIDIA Jetson Orin Nano devkit with microSD root storage.
# For NVMe root storage, use jetson-orin-nano-devkit-nvme.
MACHINE = "jetson-orin-nano-devkit"
DISTRO = "poky"
INIT_MANAGER = "systemd"

# Mender classic OTA integration for JetPack 7 / meta-tegra Wrynose.
# The community layer coordinates Mender rootfs A/B updates with nvbootctrl
# and NVIDIA UEFI capsule updates.
INHERIT += "mender-full tegra-mender-classic"
MENDER_ARTIFACT_NAME = "${IMAGE_NAME}"
MENDER_FEATURES_DISABLE:append = " mender-uboot"
USE_REDUNDANT_FLASH_LAYOUT_DEFAULT = "1"
UBOOT_EXTLINUX = "1"

# Set this to your hosted or self-managed Mender server before enrolling devices.
# MENDER_SERVER_URL = "https://mender.example.com"

# Development convenience only; remove for production images.
EXTRA_IMAGE_FEATURES += "empty-root-password allow-root-login"

DL_DIR ?= "${TOPDIR}/../downloads"
SSTATE_DIR ?= "${TOPDIR}/../sstate-cache"
