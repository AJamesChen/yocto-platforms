# Build for the NVIDIA Jetson Orin Nano devkit with microSD root storage.
# For NVMe root storage, use jetson-orin-nano-devkit-nvme.
MACHINE = "jetson-orin-nano-devkit"
DISTRO = "poky"

# Generate the deployable NVIDIA flashing bundle.
IMAGE_CLASSES += "image_types_tegra"
IMAGE_FSTYPES = "tegraflash"

# Development convenience only; remove for production images.
EXTRA_IMAGE_FEATURES += "debug-tweaks"

DL_DIR ?= "${TOPDIR}/../downloads"
SSTATE_DIR ?= "${TOPDIR}/../sstate-cache"
